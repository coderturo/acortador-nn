---
import Layout from '../layouts/Layout.astro'
import { db } from '../lib/db'
import links from '../data/links.json'

export const prerender = false

type Link = { url: string; categoria: string }
const linksTipados = links as Record<string, Link>

const result = await db.execute(`
  SELECT slug, day, count
  FROM clicks_daily
  WHERE day >= date('now', '-6 days')
  ORDER BY slug, day
`)

const porSlug: Record<string, { day: string; count: number }[]> = {}
for (const row of result.rows) {
  const slug = row.slug as string
  if (!porSlug[slug]) porSlug[slug] = []
  porSlug[slug].push({ day: row.day as string, count: row.count as number })
}

// Generamos los últimos 7 días como strings "YYYY-MM-DD", del más viejo al más nuevo (hoy al final)
function ultimosSieteDias() {
  const dias: string[] = []
  for (let i = 6; i >= 0; i--) {
    const d = new Date()
    d.setDate(d.getDate() - i)
    dias.push(d.toISOString().slice(0, 10))
  }
  return dias
}
const diasSemana = ultimosSieteDias()

const slugs = Object.keys(linksTipados).sort()

function limpiarUrl(url: string) {
  return url.replace(/^https?:\/\//, '').replace(/\/$/, '')
}

const SPARK_ANCHO = 50
const SPARK_ALTO = 22
const BARRA_ANCHO = 4
const BARRA_GAP = 3
const BARRA_MIN = 2
const BARRA_MAX = 16

const filasData = slugs.map((slug) => {
  const conteoPorDia = Object.fromEntries(
    (porSlug[slug] ?? []).map((f) => [f.day, f.count])
  )
  const valoresSpark = diasSemana.map((dia) => conteoPorDia[dia] ?? 0)
  const totalSemana = valoresSpark.reduce((acc, v) => acc + v, 0)
  const maxSpark = Math.max(...valoresSpark, 1)

  const barras = valoresSpark.map((valor, i) => {
    const altura =
      valor === 0 ? BARRA_MIN : Math.max(BARRA_MIN, Math.round((valor / maxSpark) * BARRA_MAX))
    return {
      x: 2 + i * (BARRA_ANCHO + BARRA_GAP),
      y: SPARK_ALTO - altura - 2,
      altura,
      conClicks: valor > 0,
      esHoy: i === valoresSpark.length - 1,
    }
  })

  const ultimoDiaConClicks =
    [...diasSemana].reverse().find((dia) => (conteoPorDia[dia] ?? 0) > 0) ?? ''

  return {
    slug,
    destino: linksTipados[slug].url,
    categoria: linksTipados[slug].categoria,
    totalSemana,
    ultimoDiaConClicks,
    barras,
  }
})
---

<Layout>
  <main>
    <header class="cabecera">
      <p class="marca">nuevosnegocios.site</p>
      <h1>link.nuevosnegocios.site</h1>
      <p class="subtitulo">{slugs.length} enlaces disponibles</p>
    </header>

    <div class="toolbar">
      <div class="buscador-wrapper">
        <svg class="icono-lupa" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="m20 20-3-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input
          type="text"
          id="buscador"
          placeholder="Buscar por nombre, destino o categoría…"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="tecla">/</kbd>
      </div>

      <div class="tabs" role="group" aria-label="Ordenar enlaces">
        <button class="tab" data-orden="az" type="button" aria-pressed="true">A–Z</button>
        <button class="tab" data-orden="clicks" type="button" aria-pressed="false">Clicks</button>
        <button class="tab" data-orden="recientes" type="button" aria-pressed="false">Recientes</button>
      </div>
    </div>

    <ul class="lista" id="lista">
      {filasData.map(({ slug, destino, categoria, totalSemana, ultimoDiaConClicks, barras }) => (
        <li
          class="fila"
          data-slug={slug}
          data-destino={limpiarUrl(destino)}
          data-categoria={categoria}
          data-clicks={totalSemana}
          data-reciente={ultimoDiaConClicks}
        >
          <a class="enlace" href={`/${slug}`} target="_blank" rel="noopener noreferrer">
            <div class="linea-superior">
              <span class="slug">/{slug}</span>
              <span class="badge">{categoria}</span>
            </div>
            <span class="destino">{limpiarUrl(destino)}</span>
          </a>

          <div class="analitica">
            <svg
              class="spark"
              viewBox={`0 0 ${SPARK_ANCHO} ${SPARK_ALTO}`}
              width={SPARK_ANCHO}
              height={SPARK_ALTO}
              aria-hidden="true"
            >
              {barras.map((b) => (
                <rect
                  x={b.x}
                  y={b.y}
                  width={BARRA_ANCHO}
                  height={b.altura}
                  rx="1"
                  class:list={[
                    'barra',
                    { 'con-clicks': b.conClicks, 'es-hoy': b.esHoy },
                  ]}
                />
              ))}
            </svg>
            <span class="stat">
              <span class="stat-valor">{totalSemana}</span>
              <span class="stat-label">7d</span>
            </span>
          </div>

          <button
            class="copiar"
            type="button"
            data-slug={slug}
            aria-label={`Copiar enlace corto de /${slug}`}
          >
            <svg class="icono-copiar" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2.5" stroke="currentColor" stroke-width="2" />
              <path d="M5 15V5.5A1.5 1.5 0 0 1 6.5 4H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <svg class="icono-check" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m5 12 4.5 4.5L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </li>
      ))}
    </ul>

    <p class="sin-resultados" id="sinResultados" hidden>
      No se encontraron enlaces.
    </p>
  </main>
</Layout>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .cabecera {
    margin-bottom: 2rem;
    text-align: center;
  }

  .marca {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    color: var(--accent);
    font-weight: 600;
  }

  h1 {
    font-family: var(--pixel);
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2.15rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .subtitulo {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .toolbar {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .buscador-wrapper {
    flex: 1 1 14rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.85rem;
    border-radius: 8px;
    background: rgba(29, 26, 24, 0.85);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.15s;
  }

  .buscador-wrapper:focus-within {
    border-color: var(--accent);
  }

  .icono-lupa {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .buscador-wrapper:focus-within .icono-lupa {
    color: var(--accent);
  }

  #buscador {
    flex: 1;
    width: 100%;
    padding: 0.75rem 0;
    background: transparent;
    border: none;
    color: var(--text);
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
  }

  #buscador::placeholder {
    color: var(--text-muted);
  }

  .tecla {
    flex-shrink: 0;
    min-width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg);
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.75rem;
  }

  .buscador-wrapper:focus-within .tecla {
    opacity: 0;
  }

  .tabs {
    flex: 0 0 auto;
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.2rem;
    border-radius: 8px;
    background: rgba(29, 26, 24, 0.85);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .tab {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.55rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
  }

  .tab:hover {
    color: var(--text);
  }

  .tab[aria-pressed='true'] {
    background: var(--accent);
    color: var(--bg);
  }

  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .fila {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
  }

  .fila[hidden] {
    display: none;
  }

  .enlace {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    min-width: 0;
  }

  .linea-superior {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .slug {
    font-weight: 600;
    font-size: 1.05rem;
  }

  .enlace:hover .slug {
    color: var(--accent);
  }

  .badge {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--accent);
  }

  .destino {
    font-size: 0.85rem;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---------- Sparkline + contador ---------- */
  .analitica {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--border);
  }

  .spark {
    display: block;
  }

  .barra {
    fill: var(--border);
  }

  .barra.con-clicks {
    fill: color-mix(in srgb, var(--accent) 55%, var(--border));
  }

  .barra.es-hoy.con-clicks {
    fill: var(--accent);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.1;
    min-width: 1.8rem;
  }

  .stat-valor {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .stat-label {
    font-size: 0.65rem;
    color: var(--text-muted);
  }

  /* ---------- Botón copiar ---------- */
  .copiar {
    flex-shrink: 0;
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-muted);
    cursor: pointer;
    position: relative;
  }

  .copiar:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .copiar svg {
    grid-area: 1 / 1;
    transition: opacity 0.15s, transform 0.15s;
  }

  .copiar .icono-check {
    opacity: 0;
    transform: scale(0.6);
    color: var(--accent);
  }

  .copiar.copiado .icono-copiar {
    opacity: 0;
    transform: scale(0.6);
  }

  .copiar.copiado .icono-check {
    opacity: 1;
    transform: scale(1);
  }

  .sin-resultados {
    color: var(--text-muted);
    text-align: center;
    padding: 2rem 0;
  }

  @media (max-width: 480px) {
    main {
      padding: 2.5rem 1.25rem;
    }

    .toolbar {
      flex-direction: column;
    }

    .tecla {
      display: none;
    }

    .spark {
      display: none;
    }
  }
</style>

<script>
  const CLAVE_ORDEN = 'nn-acortador-orden'

  const buscador = document.getElementById('buscador') as HTMLInputElement
  const lista = document.getElementById('lista') as HTMLUListElement
  const sinResultados = document.getElementById('sinResultados') as HTMLElement
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab')
  const filas = Array.from(lista.querySelectorAll<HTMLLIElement>('.fila'))

  function filtrar() {
    const termino = buscador.value.trim().toLowerCase()
    let visibles = 0

    for (const fila of filas) {
      const slug = fila.dataset.slug ?? ''
      const destino = fila.dataset.destino ?? ''
      const categoria = fila.dataset.categoria ?? ''
      const coincide =
        slug.toLowerCase().includes(termino) ||
        destino.toLowerCase().includes(termino) ||
        categoria.toLowerCase().includes(termino)

      fila.hidden = !coincide
      if (coincide) visibles++
    }

    sinResultados.hidden = visibles > 0
  }

  function ordenar(criterio: string) {
    const copia = [...filas]

    copia.sort((a, b) => {
      if (criterio === 'clicks') {
        return Number(b.dataset.clicks) - Number(a.dataset.clicks)
      }
      if (criterio === 'recientes') {
        const rA = a.dataset.reciente || ''
        const rB = b.dataset.reciente || ''
        return rB.localeCompare(rA)
      }
      return (a.dataset.slug ?? '').localeCompare(b.dataset.slug ?? '')
    })

    for (const fila of copia) {
      lista.appendChild(fila)
    }
  }

  function activarTab(criterio: string) {
    for (const t of tabs) t.setAttribute('aria-pressed', 'false')
    const tabElegida = document.querySelector<HTMLButtonElement>(`[data-orden="${criterio}"]`)
    tabElegida?.setAttribute('aria-pressed', 'true')
    ordenar(criterio)
  }

  const ordenGuardado = localStorage.getItem(CLAVE_ORDEN) ?? 'az'
  activarTab(ordenGuardado)
  filtrar()

  buscador.addEventListener('input', filtrar)

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const criterio = tab.dataset.orden ?? 'az'
      activarTab(criterio)
      localStorage.setItem(CLAVE_ORDEN, criterio)
    })
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== buscador) {
      e.preventDefault()
      buscador.focus()
      buscador.select()
    }
    if (e.key === 'Escape' && document.activeElement === buscador) {
      buscador.value = ''
      filtrar()
      buscador.blur()
    }
  })

  // ---------- Botón copiar ----------
  let resetTimer: ReturnType<typeof setTimeout>

  lista.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.copiar')
    if (!btn) return

    const url = `${location.origin}/${btn.dataset.slug}`

    try {
      await navigator.clipboard.writeText(url)
    } catch {
      return
    }

    for (const el of document.querySelectorAll('.copiar.copiado')) {
      el.classList.remove('copiado')
    }

    clearTimeout(resetTimer)
    btn.classList.add('copiado')
    resetTimer = setTimeout(() => btn.classList.remove('copiado'), 1400)
  })
</script>
